<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FixIt" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/page</item>
    </style>

    <style name="Theme.FixIt.Card" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowMinWidthMajor">60%</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
</resources>
